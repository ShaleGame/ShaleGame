metadata/_custom_type_script = "uid://fes1mq3st4mn"

[sub_resource type="Resource" id="Resource_tpyvw"]
script = ExtResource("2_t44pr")
AnimationName = "confuse"
metadata/_custom_type_script = "uid://fes1mq3st4mn"

[sub_resource type="Resource" id="Resource_rxp1p"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "..."
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_v6h3r"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "What boy?"
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_j86b1"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "Another Aether mutant named Slate. He had the power to convert Aether into matter. You had a mental link with him."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_s1qms"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "We don't actually know for certain what happened, but... when he disappeared, two things happened. "
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_f62e4"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "First, we noticed a burst of energy similar to what we observed with your ability to connect to the heart of the Aether itself."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_5b0d4"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "After this happened, we noticed that you were just... laughing. We couldn't get you to do anything, even eat."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_6ghr2"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "It was also the first time you demonstrated the ability to split yourself into two."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_qvvrv"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "Based on the readings we got when you made your escape, you have the same mental link with your clone as you had with him."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_a58nk"]
script = ExtResource("5_g3p00")
Frames = Array[Object]([SubResource("Resource_rxp1p"), SubResource("Resource_v6h3r"), SubResource("Resource_j86b1"), SubResource("Resource_s1qms"), SubResource("Resource_f62e4"), SubResource("Resource_5b0d4"), SubResource("Resource_6ghr2"), SubResource("Resource_qvvrv")])
metadata/_custom_type_script = "uid://dklttlk8uwht5"

[sub_resource type="Resource" id="Resource_30aoe"]
script = ExtResource("2_t44pr")
Kind = 1
DialogueReel = SubResource("Resource_a58nk")
metadata/_custom_type_script = "uid://fes1mq3st4mn"

[sub_resource type="Resource" id="Resource_ltanc"]
script = ExtResource("2_t44pr")
AnimationName = "shock"
metadata/_custom_type_script = "uid://fes1mq3st4mn"

[sub_resource type="Resource" id="Resource_ipamr"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "So... you suspect that I absorbed this Slate person?"
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_mrygm"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "Heh. Perhaps."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_sqo8s"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "Perhaps he's still in your mind. Keeping you pressing forward. Protecting you from things he doesn't want you to witness."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_5ji8k"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "I want a bit of confirmation for that theory. I want to know..."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_6vgep"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "When exactly was the first time you remember being able to clone yourself?"
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_ye4ld"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "I... I don't really remember..."
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_kn8vy"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "As far as I'm aware I've always been able to..."
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_3nvrm"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "Really? Do you remember anything from further back than... let's just say... a month or two ago?"
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_2ux4v"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "Why...?"
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_xvkrt"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "Why can't I remember?"
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_7yl6a"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "Thought so. How fascinating..."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_o1d4d"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "I'm certain Slate remembers, somewhere in your heart."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

