[sub_resource type="Resource" id="Resource_kb1ar"]
script = ExtResource("2_t44pr")
AnimationName = "start"
metadata/_custom_type_script = "uid://fes1mq3st4mn"

[sub_resource type="Resource" id="Resource_1fq3g"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "Honestly, I've been wondering... Why don't you remember anything? It's not as though you weren't around for the experience. "
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_g3p00"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "I don't know. Maybe you did something?"
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_u7i3u"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "That would be utterly pointless. Why would *I* want to do anything to you, other than study your Aether mutation?"
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_aaa5u"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "You locked me up, then hunted me down when I got away, didn't you?"
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_4wq88"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "You say that as if I'm a common kidnapper..."
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_lwxfc"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "It was all to advance research into Aether, and sometimes advancing science requires making sacrifices~"
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_fluiq"]
script = ExtResource("4_tpyvw")
Speaker = "Shale"
Text = "Like what, the entire ecosystem of the Chasm that the Heap depends on?"
Portrait = Array[Texture2D]([ExtResource("5_tpyvw")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_svr6l"]
script = ExtResource("4_tpyvw")
Speaker = "Dr. Cypher"
Text = "Like whatever happened with that boy! What did you do to him?"
Portrait = Array[Texture2D]([ExtResource("3_852qs")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_jpsom"]
script = ExtResource("5_g3p00")
Frames = Array[Object]([SubResource("Resource_1fq3g"), SubResource("Resource_g3p00"), SubResource("Resource_u7i3u"), SubResource("Resource_aaa5u"), SubResource("Resource_4wq88"), SubResource("Resource_lwxfc"), SubResource("Resource_fluiq"), SubResource("Resource_svr6l")])
metadata/_custom_type_script = "uid://dklttlk8uwht5"

