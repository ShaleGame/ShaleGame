[sub_resource type="Resource" id="Resource_cqitx"]
script = ExtResource("2_unjls")
AnimationName = "start"
metadata/_custom_type_script = "uid://fes1mq3st4mn"

[sub_resource type="Resource" id="Resource_as7qo"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "So like, I know that we didn't always get along, but why are you back anyway? "
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_k2568"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "Didn't you want to get back to your little village instead of contributing to the advancement of humanity?"
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_sef2d"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "Or at least the advancement of Corporate's quarterly profits... I never did feel like I was allowed to do enough..."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_8m6fw"]
script = ExtResource("4_pin04")
Speaker = "Shale"
Text = "I don't know what you're talking about, I don't know you!"
Portrait = Array[Texture2D]([ExtResource("5_5n0av")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_pin04"]
script = ExtResource("4_pin04")
Speaker = "Shale"
Text = "I just want to find why the ground's been getting colder! Our crops are dying out! Our people are starving!"
Portrait = Array[Texture2D]([ExtResource("5_5n0av")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_bebvb"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "Hey, we haven't been doing great here either! Do you know how much I miss actual food?"
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_5n0av"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "Scuttler stew is no way for the one reversing global warming to be fed!"
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_pdvwp"]
script = ExtResource("4_pin04")
Speaker = "Shale"
Text = "Reversing global warming? Are you saying the planet was too hot?"
Portrait = Array[Texture2D]([ExtResource("5_5n0av")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_wb62g"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "You wouldn't have been around for this, and neither would I. It all happened long before we were born."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_jdrje"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "Our ancestors polluted this world by burning the decayed sludge of the massive dragons that populated it long before they were born."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_78gi1"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "It got to a point where sunlight was captured by an invisible barrier of this pollution."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_b68sn"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "This invisible barrier heated the world to a point of instability and inhospitability"
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_44w2a"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "A select few were able to escape to the stars, and Sol's system is now host to a smattering of colonies and stations."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_s0th7"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "The Pillars are a controlled environment that more of humanity survives in."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_l144g"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "These Pillars are owned by Aether Dynamics, and are used to harvest the Earth for whatever Corporate wants."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_aau2i"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "Disobey them, and you've lost everything."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_3ck6a"]
script = ExtResource("4_pin04")
Speaker = "Shale"
Text = "..."
Portrait = Array[Texture2D]([ExtResource("5_5n0av")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_tjgvn"]
script = ExtResource("4_pin04")
Speaker = "Dr. Cypher"
Text = "Anyway, yes, it was too hot. I'm making it colder. Any questions? No? Okay."
Portrait = Array[Texture2D]([ExtResource("3_r8l8n")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

