[sub_resource type="Resource" id="Resource_8546g"]
script = ExtResource("1_jfsr7")
Speaker = "Shale's Diary"
Text = "The Aether in this zone is especially cold. I wasn't sure at first why, but it seems like it's being sapped for its energy in some way."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_jfsr7"]
script = ExtResource("1_jfsr7")
Speaker = "Shale's Diary"
Text = "Aether is everywhere, and whatever it is that living near the Chasm has done makes me physically sensitive to it."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_3liyh"]
script = ExtResource("1_jfsr7")
Speaker = "Shale's Diary"
Text = "While I don't think I have to worry about freezing to death from it, I wish I had a warm coat..."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

