[sub_resource type="Resource" id="Resource_rd1io"]
script = ExtResource("1_ack2d")
Speaker = "Torn-out diary page"
Text = "We were taken into a long tunnel, judging by the smell. Not sure how far we were taken. They've at least kept us fed. "
Portrait = Array[Texture2D]([ExtResource("1_fj6wk")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_ack2d"]
script = ExtResource("1_ack2d")
Speaker = "Torn-out diary page"
Text = "And together. I've seen a few kids taken away from our village. Anyone who has weird powers, especially."
Portrait = Array[Texture2D]([ExtResource("1_fj6wk")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_fj6wk"]
