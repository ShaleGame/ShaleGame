[sub_resource type="Resource" id="Resource_73pho"]
script = ExtResource("1_c8iqt")
Speaker = "Shale"
Text = "I remember the warm smile of someone with gray hair carrying me through the woods."
Portrait = Array[Texture2D]([ExtResource("1_qa4by")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_c8iqt"]
script = ExtResource("1_c8iqt")
Speaker = "Shale"
Text = "I remember catching a cold when day turned to night and we got caught in a storm."
Portrait = Array[Texture2D]([ExtResource("1_qa4by")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_qa4by"]
script = ExtResource("1_c8iqt")
