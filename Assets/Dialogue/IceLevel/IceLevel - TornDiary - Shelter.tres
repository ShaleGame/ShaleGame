[sub_resource type="Resource" id="Resource_srp3l"]
script = ExtResource("1_woemi")
Speaker = "Torn-out diary page"
Text = "I saw her body at the bottom of the scuttlers' den. I knew I couldn't save her. I ran. I didn't know what else to do."
Portrait = Array[Texture2D]([ExtResource("1_vnt2h")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_woemi"]
script = ExtResource("1_woemi")
Speaker = "Torn-out diary page"
Text = "The Chasm only became more trecherous from there, with icy floating platforms and far scarier monsters."
Portrait = Array[Texture2D]([ExtResource("1_vnt2h")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_vnt2h"]
script = ExtResource("1_woemi")
Speaker = "Torn-out diary page"
Text = "Did Dr. Cypher know that sending us out to find that Shale kid was a suicide mission? Did he care?"
Portrait = Array[Texture2D]([ExtResource("1_vnt2h")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_qcd4x"]
script = ExtResource("1_woemi")
Speaker = "Torn-out diary page"
Text = "Is that kid even still alive? I only barely managed to get myself into this little hole, which I'm probably going to die in. "
Portrait = Array[Texture2D]([ExtResource("1_vnt2h")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_og7bn"]
script = ExtResource("1_woemi")
Speaker = "Torn-out diary page"
Text = "I've lost everything that's important to me. What's even the point in pretending that I can go back after this?"
Portrait = Array[Texture2D]([ExtResource("1_vnt2h")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

