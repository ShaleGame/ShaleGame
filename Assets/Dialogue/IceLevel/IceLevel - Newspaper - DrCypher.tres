[ext_resource type="Script" uid="uid://dag8a1mnv4sxx" path="res://Environment/Cutscene/DialogueFrame.cs" id="1_625k7"]
[ext_resource type="Script" uid="uid://dklttlk8uwht5" path="res://Environment/Cutscene/DialogueReel.cs" id="2_6x8k0"]

[sub_resource type="Resource" id="Resource_nesel"]
script = ExtResource("1_625k7")
Speaker = "Lunarian Digest"
Text = "Dr. File Cypher, the Director of Energy Development & Research at Aether Dynamics, has recently unveiled his laboratory's latest invention."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_625k7"]
script = ExtResource("1_625k7")
Speaker = "Lunarian Digest"
Text = "According to the famous scientist, the new Aether extraction technology is predicted to provide a 50% energy gain over the previous model."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_6x8k0"]
script = ExtResource("1_625k7")
Speaker = "Lunarian Digest"
Text = "But, enough about the tech! Who exactly is the man, the legend, whose brilliant career started an energy revolution for humanity?"
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_370de"]
script = ExtResource("1_625k7")
Speaker = "Lunarian Digest"
Text = "Our reporters have been persistently trying to interview him for months, but every time we're told to go away! "
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_a53v6"]
script = ExtResource("1_625k7")
Speaker = "Lunarian Digest"
Text = "It might be that he doesn't like talking to our beautiful array of celebrity reporters, but never fear! We won't let anything stand in the way of ratings!"
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

