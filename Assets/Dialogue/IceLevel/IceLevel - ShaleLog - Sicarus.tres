[sub_resource type="Resource" id="Resource_flggd"]
script = ExtResource("1_flggd")
Speaker = "Shale's Diary"
Text = "It hadn't been seen since the cool winds started coming from the ground. I was wondering what happened to it."
Portrait = Array[Texture2D]([ExtResource("1_tnb6q")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_tnb6q"]
script = ExtResource("1_flggd")
Speaker = "Shale's Diary"
Text = "It seemed to have mutated from the last time I saw it. Probably a result of the cold Aether."
Portrait = Array[Texture2D]([ExtResource("1_tnb6q")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

