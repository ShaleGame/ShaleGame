[sub_resource type="Resource" id="Resource_75go0"]
script = ExtResource("1_em367")
Speaker = "Shale's Diary"
Text = "I know that the actual effects are a tragedy, but I caught a glimpse of the Aether Lake up ahead in the icy condiitons."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_em367"]
script = ExtResource("1_em367")
Speaker = "Shale's Diary"
Text = "It has a unique beauty, the glow of the Aether underneath the iridescent frozen surface, and the stalagtites sheering into icicles."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_ilsuq"]
script = ExtResource("1_em367")
Speaker = "Shale's Diary"
Text = "Even destruction has beauty, in the end"
