[sub_resource type="Resource" id="Resource_dyxde"]
script = ExtResource("1_3uxbr")
Speaker = "Dr. Cypher"
Text = "It seems, based on our recordings, that she's been talking to someone who isn't in the room. "
Portrait = Array[Texture2D]([ExtResource("1_rw26w")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_whaoh"]
script = ExtResource("1_3uxbr")
Speaker = "Dr. Cypher"
Text = "Everything she's said has been recorded, of course, and when she's doing so, the Aether readings in the room create"
Portrait = Array[Texture2D]([ExtResource("1_rw26w")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_80dkn"]
script = ExtResource("1_3uxbr")
Speaker = "Dr. Cypher"
Text = "unique waveforms that we haven't managed to simulate in Aether circuitry. They also cause energy"
Portrait = Array[Texture2D]([ExtResource("1_rw26w")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_rpean"]
