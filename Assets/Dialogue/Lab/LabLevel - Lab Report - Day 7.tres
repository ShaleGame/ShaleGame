Speaker = "Dr. Cypher"
Text = "readings to intensify immensely, despite nothing in the room changing. It's fascinating to say the least."
Portrait = Array[Texture2D]([ExtResource("1_rw26w")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_tjl2w"]
script = ExtResource("1_3uxbr")
Speaker = "Dr. Cypher"
Text = "I wonder what might be causing these readings to increase. If we can extract the energy from it, we can potentially"
Portrait = Array[Texture2D]([ExtResource("1_rw26w")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_0ev8n"]
script = ExtResource("1_3uxbr")
Speaker = "Dr. Cypher"
Text = "use it to help bridge the gap that the ban on fossil fuels left in human civilization. What's left of humanity"
Portrait = Array[Texture2D]([ExtResource("1_rw26w")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_pyb3c"]
