[sub_resource type="Resource" id="Resource_g1n6s"]
script = ExtResource("1_vm47a")
Speaker = "Lunarian Financial Times"
Text = "Dr. Cypher's disappearance has shook waves across the System. The famous scientist was last seen over a month ago, and many of his fans are eagerly awaiting news from the Chasm Pillar."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_qpnlp"]
script = ExtResource("1_vm47a")
Speaker = "Lunarian Financial Times"
Text = " A spokesperson from Aether Dynamics spoke in his place, stating that the research on Cold Aether was proceeding as planned. "
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_d8xs6"]
script = ExtResource("1_vm47a")
Speaker = "Lunarian Financial Times"
Text = "However, share prices for AETR have fallen 1% over the past month, leaving investors questioning their choices."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_5h6v8"]
script = ExtResource("1_vm47a")
Speaker = "Lunarian Financial Times"
Text = "An investigative team from the Pillar has started interviewing the citizens of the Heap, who Aether Dynamics is accusing of foul play."
Portrait = null
