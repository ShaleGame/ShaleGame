[sub_resource type="Resource" id="Resource_w2m42"]
script = ExtResource("1_yjkdx")
Speaker = "Dr. Cypher"
Text = "We lost Sylva. I severely underestimated the Chasm. We don't have the materials or supplies to try to search further. "
Portrait = null
