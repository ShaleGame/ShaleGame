Text = "I tried sending a warning to Rose and Alma to get back to the lab, but I'm not sure if they received the warning."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_xhabk"]
