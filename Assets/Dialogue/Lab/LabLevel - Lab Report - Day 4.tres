[sub_resource type="Resource" id="Resource_g2dr1"]
script = ExtResource("1_yvxll")
Speaker = "Dr. Cypher"
Text = "After running Slate through some tests, we've observed some interesting results. He has the ability to create matter from Aether energy, and It seems that he has a psychic link with Shale."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_hrdrq"]
script = ExtResource("1_yvxll")
Speaker = "Dr. Cypher"
Text = "This psychic link is particularly interesting. If he's near the girl, his abilities are more refined, even to the point of creating distinct molecular structures with a high degree of purity."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_euwn8"]
script = ExtResource("1_yvxll")
Speaker = "Dr. Cypher"
Text = "If not, he might as well be an ordinary human. This will require more research."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

