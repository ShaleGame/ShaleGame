[sub_resource type="Resource" id="Resource_qpnlp"]
script = ExtResource("1_2xrrk")
Speaker = "Dr. Cypher"
Text = "Shale's gone. No food. Corporate's basically abandoned us. At this point, we either have to find her or abandon the facility entirely. I sent Sylva, Rose, and Alma out to find her."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_w2m42"]
script = ExtResource("1_2xrrk")
Speaker = "Dr. Cypher"
Text = "A fascinating aspect of this is that Shale demonstrated a new ability - she seems to have the ability to split herself into two."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_efkql"]
script = ExtResource("1_2xrrk")
Speaker = "Dr. Cypher"
Text = "What's more, these two versions of her act as though they have a mental link. The mental link is something I've never seen outside of Slate's abilities."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

