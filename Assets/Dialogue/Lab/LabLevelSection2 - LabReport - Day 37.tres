[sub_resource type="Resource" id="Resource_xhabk"]
script = ExtResource("1_cf7am")
Speaker = "Dr. Cypher"
Text = "A drone found Rose and Alma's bodies. I got a letter -- physical mail, expensive -- demoting me from my head scientist position."
