[sub_resource type="Resource" id="Resource_h87ra"]
script = ExtResource("1_fevx7")
Speaker = "Dr. Cypher"
Text = "I keep seeing their glowing, pink eyes in my sleep. I keep seeing the two of them in my dreams. I don't know why, but they barely feel like different people at this point."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_pg4fu"]
script = ExtResource("1_fevx7")
Speaker = "Dr. Cypher"
Text = "I'll try not to get distracted. Haven't heard back from Rose and Alma. No particularly strong energy readings, though I'm not sure whether any signal will come through."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_d8xs6"]
script = ExtResource("1_fevx7")
Speaker = "Dr. Cypher"
Text = "Given the noise of the Chasm's own Aether, that is."
Portrait = null
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_5h6v8"]
script = ExtResource("1_fevx7")
