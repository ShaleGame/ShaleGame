[sub_resource type="Resource" id="Resource_g2dr1"]
script = ExtResource("1_6p7hb")
Speaker = "Dr. Cypher"
Text = "My assistants brought us a couple new mutant lab rats from the Heap. A young girl, Shale, and a slightly older boy, Slate. "
