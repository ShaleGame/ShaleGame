[sub_resource type="Resource" id="Resource_hrdrq"]
script = ExtResource("1_gkr0h")
Speaker = "Torn-out diary page"
Text = "It's been about a week since we were taken from the Heap. Shale's mostly been with me the whole time."
Portrait = Array[Texture2D]([ExtResource("1_knyi7")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_g2dr1"]
script = ExtResource("1_gkr0h")
Speaker = "Torn-out diary page"
Text = "I've been told that my abilities are special, and the interns are giving me warm smiles, but the head scientist seems antsy."
Portrait = Array[Texture2D]([ExtResource("1_knyi7")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_mnqy0"]
script = ExtResource("1_gkr0h")
Speaker = "Torn-out diary page"
Text = "I just hope we can go home soon, after they're done with whatever it is that they wanted to check us for."
Portrait = Array[Texture2D]([ExtResource("1_knyi7")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_whaoh"]
script = ExtResource("1_gkr0h")
Speaker = "Torn-out diary page"
Text = "Creating tungsten cubes is incredibly boring, and I don't know how much more information they can get from us."
Portrait = Array[Texture2D]([ExtResource("1_knyi7")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_rhe3c"]
script = ExtResource("1_gkr0h")
Speaker = "Torn-out diary page"
Text = "It's not like I understand my own abilities myself..."
Portrait = Array[Texture2D]([ExtResource("1_knyi7")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

