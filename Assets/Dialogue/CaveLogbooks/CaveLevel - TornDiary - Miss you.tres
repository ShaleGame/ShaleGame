[sub_resource type="Resource" id="Resource_bd3yc"]
script = ExtResource("1_33ke3")
Speaker = "Torn-out diary entry"
Text = "...I need her back. My heart can't handle this world without that beautiful flower."
Portrait = Array[Texture2D]([ExtResource("1_rkcw0")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_ys7pi"]
script = ExtResource("1_33ke3")
Speaker = "Torn-out diary entry"
Text = "The security systems in the tunnels where we were stationed to work are built to work in pairs."
Portrait = Array[Texture2D]([ExtResource("1_rkcw0")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_85g5w"]
script = ExtResource("1_33ke3")
Speaker = "Torn-out diary entry"
Text = "It's not like I wanted to be working with her. We had no choice but to work together... at least that's how it started."
Portrait = Array[Texture2D]([ExtResource("1_rkcw0")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_tsqnk"]
script = ExtResource("1_33ke3")
Speaker = "Torn-out diary entry"
Text = "All I can do alone is sit and wait to be rescued... as if that'll ever happen. Dr. Cypher isn't one to reward failure..."
Portrait = Array[Texture2D]([ExtResource("1_rkcw0")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_1ojgl"]
script = ExtResource("1_33ke3")
Speaker = "Torn-out diary entry"
Text = "My failure... letting you slip into the void..."
Portrait = Array[Texture2D]([ExtResource("1_rkcw0")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

