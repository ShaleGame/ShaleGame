[sub_resource type="Resource" id="Resource_o5kyg"]
script = ExtResource("2_xyrf3")
Speaker = "Shale"
Text = "It reminds me of a gentle gaze I remember seeing. The eyes of an angel. The warmth. The comforting glow."
Portrait = Array[Texture2D]([ExtResource("1_uqbsp")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_20j1j"]
script = ExtResource("2_xyrf3")
Speaker = "Shale"
Text = "I can't hear him. I could have just imagined or dreamed him. But I want to find him."
