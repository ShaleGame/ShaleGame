[sub_resource type="Resource" id="Resource_ikyvi"]
script = ExtResource("2_e4h1o")
Speaker = "Shale's Diary"
Text = "I have some vague memories of passing through this area, but it's weird, it feels like someone else's memories. "
Portrait = Array[Texture2D]([ExtResource("1_yqgt5")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_ertrq"]
script = ExtResource("2_e4h1o")
Speaker = "Shale's Diary"
Text = "I haven't been here, as far as I know. When I was found by the people of the Heap, my mind was a blank slate..."
Portrait = Array[Texture2D]([ExtResource("1_yqgt5")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

[sub_resource type="Resource" id="Resource_vcy6m"]
script = ExtResource("2_e4h1o")
Speaker = "Shale's Diary"
Text = "What I do know, is that even though it doesn't feel like it's me, it still feels like a comfort."
Portrait = Array[Texture2D]([ExtResource("1_yqgt5")])
metadata/_custom_type_script = "uid://dag8a1mnv4sxx"

